rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Turfs ──
    // Anyone can read active turfs (for customer browse/search)
    // Authenticated owners can create/update their own turfs
    match /turfs/{turfId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.ownerId == request.auth.uid
                        || request.resource.data.ownerId == request.auth.uid);
      allow delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
    }

    // ── Bookings ──
    // Customers can read/write their own bookings
    match /bookings/{bookingId} {
      allow read: if request.auth != null
                  && (resource.data.userId == request.auth.uid
                      || resource.data.ownerId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.userId == request.auth.uid
                        || resource.data.ownerId == request.auth.uid);
    }

    // ── Users ──
    // Users can read/write their own profile.
    // Turf owners can read/write employee profiles they own.
    match /users/{userId} {
      allow read: if request.auth != null 
                  && (request.auth.uid == userId 
                      || resource.data.ownerId == request.auth.uid);
      allow create: if request.auth != null 
                    && (request.auth.uid == userId 
                        || request.resource.data.ownerId == request.auth.uid);
      allow update: if request.auth != null 
                    && (request.auth.uid == userId 
                        || resource.data.ownerId == request.auth.uid 
                        || request.resource.data.ownerId == request.auth.uid);
      allow delete: if request.auth != null 
                    && (request.auth.uid == userId 
                        || resource.data.ownerId == request.auth.uid);
    }

    match /user_profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Owner Profiles ──
    match /owner_profiles/{ownerId} {
      allow read, write: if request.auth != null && request.auth.uid == ownerId;
    }

    // ── Reviews ──
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
                             && resource.data.userId == request.auth.uid;
    }
  }
}

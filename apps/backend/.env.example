# Server Config
PORT=5000
NODE_ENV=development

# Database Config
# Provider can be "prisma" (default PostgreSQL) or "firebase" (Firestore)
DATABASE_PROVIDER=prisma

# Relational Database connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/turf_booking?schema=public"

# Redis Cache Config
REDIS_URL="redis://localhost:6379"

# Security Config
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-key-change-in-production"
JWT_EXPIRE="7d"

# Cloudinary Storage Config
CLOUDINARY_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Payments Config (Razorpay)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_SECRET="your_razorpay_secret"

# Email Config (Nodemailer)
NODEMAILER_HOST="smtp.mailtrap.io"
NODEMAILER_PORT=2525
NODEMAILER_USER="your_nodemailer_username"
NODEMAILER_PASS="your_nodemailer_password"

# Maps API
GOOGLE_MAPS_API_KEY="your_google_maps_api_key"

# Firebase Cloud & SDK Credentials
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-firebase-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET="your-firebase-project.appspot.com"

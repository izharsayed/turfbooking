# TurfBook Mobile Environment Variables
# For Expo, environment variables must be prefixed with EXPO_PUBLIC_ to be exposed to the client bundle.

# 1. Google Web Client ID (from Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs)
# Required for both Android and iOS configuration of `@react-native-google-signin/google-signin`.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID="YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com"

# 2. Firebase Config (from Firebase Console -> Project Settings -> General -> Web App)
EXPO_PUBLIC_FIREBASE_API_KEY="AIzaSyCUsd6go9iEuM8wbDAFQ8pHhoGskoATUK4"
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN="turfbook-74c8c.firebaseapp.com"
EXPO_PUBLIC_FIREBASE_PROJECT_ID="turfbook-74c8c"
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET="turfbook-74c8c.firebasestorage.app"
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="322171909313"
EXPO_PUBLIC_FIREBASE_APP_ID="1:322171909313:web:4c76fb021307ea7a59d040"

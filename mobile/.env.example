# TurfBook Mobile (Expo) environment variables
# WARNING: every EXPO_PUBLIC_* variable is embedded in the client app bundle.
# Only put PUBLIC-safe values here. Never put server secrets (JWT secrets,
# Razorpay key secret, Firebase service-account/private key, etc.).

# Google Web Client ID (Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs).
# This is a public identifier; the OAuth CLIENT SECRET (if any) stays server-side.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID="YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com"

# Firebase Web App config (Firebase Console -> Project Settings -> General -> Web App).
# These identify the project and are client-safe ONLY when Firebase Security Rules
# are properly locked down on Firestore/Storage. Verify rules before shipping.
EXPO_PUBLIC_FIREBASE_API_KEY="your_firebase_web_api_key"
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
EXPO_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="000000000000"
EXPO_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:xxxxxxxxxxxxxxxx"

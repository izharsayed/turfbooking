{
  "expo": {
    "name": "TurfBook Mobile",
    "slug": "turfbook-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.jpg",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.turfbook.customer"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.jpg",
        "backgroundColor": "#020617"
      },
      "package": "com.turfbook.customer"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.YOUR_IOS_CLIENT_ID"
        }
      ],
      "expo-web-browser"
    ],
    "scheme": "turfbook",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1297cb6f-3849-47d9-bcf3-48cf152f1b43"
      }
    }
  }
}

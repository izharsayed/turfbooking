datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  SUPER_ADMIN
  TURF_OWNER
  CUSTOMER
}

enum DeviceType {
  ANDROID
  IOS
  WEB
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

enum BlockReason {
  MAINTENANCE
  HOLIDAY
  CUSTOM
}

enum BookingStatus {
  PENDING
  PENDING_CONFIRMATION
  CONFIRMED
  COMPLETED
  CANCELLED
  EXPIRED
  REFUNDED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PENDING_CONFIRMATION
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NET_BANKING
  WALLET
  CASH
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum CouponDiscountType {
  FLAT
  PERCENTAGE
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
}

// ==========================================
// CORE IDENTITY & PROFILE MODULE
// ==========================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  phone        String   @unique
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  // Relations
  profile         UserProfile?
  ownerProfile    OwnerProfile?
  pushTokens      PushToken[]
  bookings        Booking[]
  payments        Payment[]
  reviews         Review[]
  favorites       Favorite[]
  notifications   Notification[]
  supportTickets  SupportTicket[]
  supportMessages SupportMessage[]
  subscriptions   Subscription[]
  auditLogs       AuditLog[]
  activityLogs    ActivityLog[]
  wallet          Wallet?
  Turf            Turf[]
  CouponUsage     CouponUsage[]

  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

model UserProfile {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @unique @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  gender           String?
  dob              DateTime?
  address          String?
  customAttributes Json?

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@map("user_profiles")
}

model OwnerProfile {
  id                     String @id @default(uuid()) @db.Uuid
  userId                 String @unique @db.Uuid
  user                   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName            String
  businessRegisterNumber String
  businessAddress        String
  billingEmail           String

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@map("owner_profiles")
}

model PushToken {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @db.Uuid
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String     @unique
  deviceType DeviceType
  isActive   Boolean    @default(true)

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([userId, isActive])
  @@map("push_tokens")
}

// ==========================================
// GEOGRAPHY & SPORTS TAXONOMY
// ==========================================

model Sport {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  // Relations
  turfs          TurfSport[]
  couponSports   CouponSport[]
  bookings       Booking[]
  availableSlots AvailableSlot[]

  @@map("sports")
}

model City {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  slug     String  @unique
  state    String
  isActive Boolean @default(true)

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  // Relations
  areas        Area[]
  turfs        Turf[]
  couponCities CouponCity[]

  @@map("cities")
}

model Area {
  id       String  @id @default(uuid()) @db.Uuid
  cityId   String  @db.Uuid
  city     City    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name     String
  slug     String
  zipcode  String
  isActive Boolean @default(true)

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  // Relations
  turfs Turf[]

  @@unique([cityId, slug])
  @@map("areas")
}

// ==========================================
// TURF OPERATIONAL LAYERS
// ==========================================

model Turf {
  id           String  @id @default(uuid()) @db.Uuid
  ownerId      String  @db.Uuid
  owner        User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cityId       String  @db.Uuid
  city         City    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  areaId       String  @db.Uuid
  area         Area    @relation(fields: [areaId], references: [id], onDelete: Cascade)
  name         String
  description  String
  address      String
  latitude     Float
  longitude    Float
  pricePerHour Float
  rating       Float   @default(0.0)
  numReviews   Int     @default(0)
  isActive     Boolean @default(true)

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  // Relations
  images          TurfImage[]
  amenities       TurfAmenity[]
  sports          TurfSport[]
  operatingHours  OperatingHour[]
  pricingRules    PricingRule[]
  holidayPricing  HolidayPricing[]
  peakHourPricing PeakHourPricing[]
  slotTemplates   SlotTemplate[]
  availableSlots  AvailableSlot[]
  blockedSlots    BlockedSlot[]
  bookings        Booking[]
  reviews         Review[]
  favorites       Favorite[]

  @@index([cityId, areaId, isActive])
  @@index([pricePerHour])
  @@index([rating])
  @@map("turfs")
}

model TurfImage {
  id           String @id @default(uuid()) @db.Uuid
  turfId       String @db.Uuid
  turf         Turf   @relation(fields: [turfId], references: [id], onDelete: Cascade)
  imageUrl     String
  displayOrder Int    @default(0)

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@map("turf_images")
}

model Amenity {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  iconUrl     String?
  description String?

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  // Relations
  turfs TurfAmenity[]

  @@map("amenities")
}

model TurfAmenity {
  id        String  @id @default(uuid()) @db.Uuid
  turfId    String  @db.Uuid
  turf      Turf    @relation(fields: [turfId], references: [id], onDelete: Cascade)
  amenityId String  @db.Uuid
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@unique([turfId, amenityId])
  @@map("turf_amenities")
}

model TurfSport {
  id      String @id @default(uuid()) @db.Uuid
  turfId  String @db.Uuid
  turf    Turf   @relation(fields: [turfId], references: [id], onDelete: Cascade)
  sportId String @db.Uuid
  sport   Sport  @relation(fields: [sportId], references: [id], onDelete: Cascade)

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@unique([turfId, sportId])
  @@map("turf_sports")
}

model OperatingHour {
  id        String  @id @default(uuid()) @db.Uuid
  turfId    String  @db.Uuid
  turf      Turf    @relation(fields: [turfId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0 = Sunday, 1 = Monday, etc.
  openTime  String // HH:MM format
  closeTime String // HH:MM format
  isActive  Boolean @default(true)

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@unique([turfId, dayOfWeek])
  @@map("operating_hours")
}

model PricingRule {
  id             String    @id @default(uuid()) @db.Uuid
  turfId         String    @db.Uuid
  turf           Turf      @relation(fields: [turfId], references: [id], onDelete: Cascade)
  name           String
  ruleType       String // weekend, holiday, event, seasonal
  baseMultiplier Float     @default(1.0)
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean   @default(true)

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@map("pricing_rules")
}

model HolidayPricing {
  id           String   @id @default(uuid()) @db.Uuid
  turfId       String   @db.Uuid
  turf         Turf     @relation(fields: [turfId], references: [id], onDelete: Cascade)
  name         String
  date         DateTime
  pricePerHour Float

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@unique([turfId, date])
  @@map("holiday_pricings")
}

model PeakHourPricing {
  id           String @id @default(uuid()) @db.Uuid
  turfId       String @db.Uuid
  turf         Turf   @relation(fields: [turfId], references: [id], onDelete: Cascade)
  name         String
  startTime    String // HH:MM format
  endTime      String // HH:MM format
  pricePerHour Float
  dayOfWeek    Int // 0 = Sunday, 1 = Monday, etc.

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@unique([turfId, dayOfWeek, startTime, endTime])
  @@map("peak_hour_pricings")
}

// ==========================================
// SLOT SCHEDULING & BOOKED ACTIVE SLOTS
// ==========================================

model SlotTemplate {
  id        String @id @default(uuid()) @db.Uuid
  turfId    String @db.Uuid
  turf      Turf   @relation(fields: [turfId], references: [id], onDelete: Cascade)
  startTime String // HH:MM format
  endTime   String // HH:MM format
  price     Float
  dayOfWeek Int // 0 = Sunday, 1 = Monday, etc.

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@map("slot_templates")
}

model AvailableSlot {
  id        String     @id @default(uuid()) @db.Uuid
  turfId    String     @db.Uuid
  turf      Turf       @relation(fields: [turfId], references: [id], onDelete: Cascade)
  sportId   String     @db.Uuid
  sport     Sport      @relation(fields: [sportId], references: [id], onDelete: Cascade)
  date      DateTime   @db.Date
  startTime DateTime
  endTime   DateTime
  price     Float
  status    SlotStatus @default(AVAILABLE)

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  // Relations
  bookingItems BookingItem[]

  @@index([turfId, date, status])
  @@index([startTime, endTime])
  @@map("available_slots")
}

model BlockedSlot {
  id        String      @id @default(uuid()) @db.Uuid
  turfId    String      @db.Uuid
  turf      Turf        @relation(fields: [turfId], references: [id], onDelete: Cascade)
  date      DateTime    @db.Date
  startTime DateTime
  endTime   DateTime
  reason    String
  blockType BlockReason @default(CUSTOM)

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([turfId, date])
  @@map("blocked_slots")
}

// ==========================================
// BOOKINGS & FINANCIAL TRANSACTIONS
// ==========================================

model Booking {
  id                 String        @id @default(uuid()) @db.Uuid
  bookingNumber      String        @unique
  userId             String        @db.Uuid
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  turfId             String        @db.Uuid
  turf               Turf          @relation(fields: [turfId], references: [id], onDelete: Cascade)
  sportId            String        @db.Uuid
  sport              Sport         @relation(fields: [sportId], references: [id], onDelete: Cascade)
  date               DateTime      @db.Date
  startTime          DateTime
  endTime            DateTime
  duration           Int // duration in minutes
  basePrice          Float
  discount           Float         @default(0.0)
  couponDiscount     Float         @default(0.0)
  tax                Float         @default(0.0)
  convenienceFee     Float         @default(0.0)
  platformCommission Float         @default(0.0)
  finalAmount        Float
  paymentStatus      PaymentStatus @default(PENDING)
  bookingStatus      BookingStatus @default(PENDING)
  bookingSource      String        @default("WEB") // WEB, MOBILE, OFFLINE
  cancellationReason String?
  refundAmount       Float         @default(0.0)

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  // Relations
  bookingItems BookingItem[]
  payments     Payment[]
  reviews      Review[]
  couponUsages CouponUsage[]

  @@index([userId])
  @@index([turfId])
  @@index([date, bookingStatus])
  @@map("bookings")
}

model BookingItem {
  id              String        @id @default(uuid()) @db.Uuid
  bookingId       String        @db.Uuid
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  availableSlotId String        @db.Uuid
  availableSlot   AvailableSlot @relation(fields: [availableSlotId], references: [id], onDelete: Cascade)
  price           Float

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@map("booking_items")
}

model Payment {
  id        String        @id @default(uuid()) @db.Uuid
  bookingId String        @db.Uuid
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId    String        @db.Uuid
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Float
  status    PaymentStatus @default(PENDING)
  method    PaymentMethod

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  // Relations
  transactions PaymentTransaction[]
  refunds      Refund[]
  invoices     Invoice[]

  @@map("payments")
}

model PaymentTransaction {
  id                   String  @id @default(uuid()) @db.Uuid
  paymentId            String  @db.Uuid
  payment              Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  gatewayTransactionId String  @unique
  amount               Float
  status               String // success, pending, failed
  payload              Json?

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@map("payment_transactions")
}

model Refund {
  id          String    @id @default(uuid()) @db.Uuid
  paymentId   String    @db.Uuid
  payment     Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount      Float
  reason      String
  status      String // pending, processed, failed
  processedAt DateTime?

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@map("refunds")
}

// ==========================================
// MARKETING, COUPONS & WALLET SYSTEM
// ==========================================

model Coupon {
  id               String             @id @default(uuid()) @db.Uuid
  code             String             @unique
  description      String?
  discountType     CouponDiscountType @default(PERCENTAGE)
  value            Float
  minBookingAmount Float              @default(0.0)
  maxDiscount      Float              @default(0.0)
  usageLimit       Int                @default(1)
  perUserLimit     Int                @default(1)
  expiryDate       DateTime
  isActive         Boolean            @default(true)

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  // Relations
  couponSports CouponSport[]
  couponCities CouponCity[]
  usages       CouponUsage[]

  @@map("coupons")
}

model CouponSport {
  id       String @id @default(uuid()) @db.Uuid
  couponId String @db.Uuid
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  sportId  String @db.Uuid
  sport    Sport  @relation(fields: [sportId], references: [id], onDelete: Cascade)

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@unique([couponId, sportId])
  @@map("coupon_sports")
}

model CouponCity {
  id       String @id @default(uuid()) @db.Uuid
  couponId String @db.Uuid
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  cityId   String @db.Uuid
  city     City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@unique([couponId, cityId])
  @@map("coupon_cities")
}

model CouponUsage {
  id        String  @id @default(uuid()) @db.Uuid
  couponId  String  @db.Uuid
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId String  @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@unique([couponId, userId, bookingId])
  @@map("coupon_usages")
}

model Wallet {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @unique @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance  Float  @default(0.0)
  currency String @default("INR")

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  // Relations
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id              String          @id @default(uuid()) @db.Uuid
  walletId        String          @db.Uuid
  wallet          Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount          Float
  transactionType TransactionType
  referenceType   String? // BOOKING, REFUND, AD_HOC
  referenceId     String?         @db.Uuid
  description     String?

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@map("wallet_transactions")
}

// ==========================================
// USER INTERACTIONS: REVIEWS, FAVS & ALERTS
// ==========================================

model Review {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  turfId     String       @db.Uuid
  turf       Turf         @relation(fields: [turfId], references: [id], onDelete: Cascade)
  bookingId  String       @db.Uuid
  booking    Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rating     Float
  comment    String
  ownerReply String?
  status     ReviewStatus @default(PENDING)

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  // Relations
  images ReviewImage[]

  @@map("reviews")
}

model ReviewImage {
  id       String @id @default(uuid()) @db.Uuid
  reviewId String @db.Uuid
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  imageUrl String

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@map("review_images")
}

model Favorite {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  turfId String @db.Uuid
  turf   Turf   @relation(fields: [turfId], references: [id], onDelete: Cascade)

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@unique([userId, turfId])
  @@map("favorites")
}

model Notification {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @db.Uuid
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  message        String
  channel        String // PUSH, EMAIL, SMS, IN_APP
  readStatus     Boolean @default(false)
  deliveryStatus String // SENT, FAILED, PENDING

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([userId, readStatus])
  @@map("notifications")
}

// ==========================================
// CUSTOMER SUPPORT CORE TICKETS
// ==========================================

model SupportTicket {
  id          String                @id @default(uuid()) @db.Uuid
  userId      String                @db.Uuid
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String
  description String
  category    String // PAYMENTS, BOOKINGS, TECHNICAL, COMPLAINT
  status      SupportTicketStatus   @default(OPEN)
  priority    SupportTicketPriority @default(MEDIUM)

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  // Relations
  messages SupportMessage[]

  @@map("support_tickets")
}

model SupportMessage {
  id            String        @id @default(uuid()) @db.Uuid
  ticketId      String        @db.Uuid
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId      String        @db.Uuid
  sender        User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  message       String
  attachmentUrl String?

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@map("support_messages")
}

// ==========================================
// ADVERTISEMENTS & MARKETING CAMPAIGNS
// ==========================================

model Advertisement {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  targetUrl   String?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  // Relations
  banners BannerImage[]

  @@map("advertisements")
}

model BannerImage {
  id              String        @id @default(uuid()) @db.Uuid
  advertisementId String        @db.Uuid
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  imageUrl        String
  position        String // HOME_TOP, SEARCH_BANNER, SIDEBAR
  displayOrder    Int           @default(0)

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@map("banner_images")
}

// ==========================================
// SUBSCRIPTIONS & OWNER PLANS
// ==========================================

model OwnerPlan {
  id           String  @id @default(uuid()) @db.Uuid
  name         String  @unique
  description  String
  price        Float
  durationDays Int
  maxTurfs     Int
  isActive     Boolean @default(true)
  features     Json?

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  // Relations
  subscriptions Subscription[]

  @@map("owner_plans")
}

model Subscription {
  id        String             @id @default(uuid()) @db.Uuid
  ownerId   String             @db.Uuid
  owner     User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  planId    String             @db.Uuid
  plan      OwnerPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  status    SubscriptionStatus @default(TRIAL)

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  // Relations
  invoices Invoice[]

  @@map("subscriptions")
}

model Invoice {
  id             String       @id @default(uuid()) @db.Uuid
  subscriptionId String       @db.Uuid
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  paymentId      String?      @db.Uuid
  payment        Payment?     @relation(fields: [paymentId], references: [id])
  invoiceNumber  String       @unique
  amount         Float
  tax            Float        @default(0.0)
  pdfUrl         String?
  billingDate    DateTime

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@map("invoices")
}

// ==========================================
// SECURITY AUDIT LOGS & SETTINGS
// ==========================================

model AuditLog {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String? @db.Uuid
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // CREATE, UPDATE, DELETE
  tableName String
  recordId  String  @db.Uuid
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([tableName, recordId])
  @@map("audit_logs")
}

model ActivityLog {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String? @db.Uuid
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  event    String // LOGIN_SUCCESS, PAYMENT_COMPLETED, etc.
  details  String?
  category String // AUTH, BOOKING, PAYMENT, SYSTEM

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([category, createdAt])
  @@map("activity_logs")
}

model ApplicationSetting {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  value       String
  description String?
  isSystem    Boolean @default(false)

  // Audit Fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@map("application_settings")
}
